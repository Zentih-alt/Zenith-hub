-- 2. DATA MODULES & CONFIGURATION TABLES (วนลูปอ่าน ModuleScript)
-- ==========================================================
local function scanDataModules()
    local moduleLines = {
        "\n========================================",
        "LAYER 2: DATA MODULES & CONFIG TABLES",
        "========================================"
    }
    local count = 0
    local targetKeywords = {"shop", "tower", "unit", "map", "item", "config", "data", "stage", "raid"}

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local lowerName = string.lower(obj.Name)
            local isMatch = false
            for _, kw in ipairs(targetKeywords) do
                if lowerName:find(kw) then
                    isMatch = true
                    break
                end
            end

            if isMatch then
                pcall(function()
                    local reqData = require(obj)
                    if type(reqData) == "table" then
                        count = count + 1
                        table.insert(moduleLines, string.format("\n-- Module [%d]: game.%s", count, obj:GetFullName()))
                        table.insert(moduleLines, "local " .. obj.Name .. "Data = " .. serializeArg(reqData, 1))
                    end
                end)
            end
        end
    end
    table.insert(moduleLines, 1, "-- Total Executed Modules: " .. tostring(count))
    return moduleLines
end

