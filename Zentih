local function serializeArg(val, indentLevel, visited)
    visited = visited or {}
    indentLevel = indentLevel or 1
    local indent = string.rep("\t", indentLevel)
    local t = typeof(val)

    if t == "string" then
        return '"' .. tostring(val) .. '"'
    elseif t == "Instance" then
        return 'game.' .. val:GetFullName()
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.2f, %.2f, %.2f)", val.X, val.Y, val.Z)
    elseif t == "CFrame" then
        return string.format("CFrame.new(%.2f, %.2f, %.2f)", val.Position.X, val.Position.Y, val.Position.Z)
    elseif t == "table" then
        if visited[val] then return "{...}" end
        visited[val] = true
        
        local isArray = true
        local maxIndex = 0
        for k, v in pairs(val) do
            if type(k) == "number" and k > 0 and math.floor(k) == k then
                if k > maxIndex then maxIndex = k end
            else
                isArray = false
            end
        end
        if #val ~= maxIndex then isArray = false end

        local entries = {}
        if isArray then
            for i, v in ipairs(val) do
                table.insert(entries, serializeArg(v, indentLevel + 1, visited))
            end
            if #entries <= 3 then
                return "{ " .. table.concat(entries, ", ") .. " }"
            else
                return "{\n" .. indent .. "\t" .. table.concat(entries, ",\n" .. indent .. "\t") .. "\n" .. indent .. "}"
            end
        else
            for k, v in pairs(val) do
                local keyStr = type(k) == "string" and ('["' .. k .. '"]') or ("[" .. tostring(k) .. "]")
                table.insert(entries, keyStr .. " = " .. serializeArg(v, indentLevel + 1, visited))
            end
            return "{\n" .. indent .. "\t" .. table.concat(entries, ",\n" .. indent .. "\t") .. "\n" .. indent .. "}"
        end
    else
        return tostring(val)
    end
end

-- Metamethod Hooking
local oldNamecall
if hookmetamethod and getrawmetatable then
    pcall(function()
        local grm = getrawmetatable(game)
        local setreadonly = setreadonly or make_writeable or function() end
        
        setreadonly(grm, false)

        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            -- เมื่อปิด Network Trace จะส่งสัญญาณกลับมาเป็นปกติ 100%
            if not Config.NetworkTraceEnabled or checkcaller() then
                return oldNamecall(self, ...)
            end

            if method == "FireServer" or method == "InvokeServer" then
                local remotePath = self:GetFullName()
                
                local isIgnored = false
                if Config.IgnoreMovement and (remotePath:find("Move") or remotePath:find("Position") or remotePath:find("Physics") or remotePath:find("Walk")) then isIgnored = true end
                if Config.IgnoreChat and (remotePath:find("Chat") or remotePath:find("SayMessage") or remotePath:find("Bubble")) then isIgnored = true end
                if Config.IgnoreAnims and (remotePath:find("Animate") or remotePath:find("HandleAnimations") or remotePath:find("Ping")) then isIgnored = true end

                if not isIgnored then
                    Config.TotalCalls = Config.TotalCalls + 1
                    Config.CapturedPaths[remotePath] = (Config.CapturedPaths[remotePath] or 0) + 1

                    local formattedArgs = {}
                    for i, arg in ipairs(args) do
                        table.insert(formattedArgs, serializeArg(arg, 1))
                    end

                    local timestamp = os.date("%H:%M:%S")
                    local logBlock = ""

                    if Config.RawScriptFormat then
                        local argsList = table.concat(formattedArgs, ",\n\t")
                        logBlock = string.format("-- [%s] [Call #%d] %s\nlocal args = {\n\t%s\n}\ngame:GetService(\"%s\"):WaitForChild(\"%s\"):FireServer(unpack(args))",
                            timestamp, Config.TotalCalls, remotePath, argsList, self.Parent and self.Parent.Name or "ReplicatedStorage", self.Name)
                        
                        if Config.LastClickedUI and (tick() - Config.LastClickTime < 0.6) then
                            logBlock = string.format("-- %s\n%s", Config.LastClickedUI, logBlock)
                            Config.LastClickedUI = nil
                        end
                    else
                        logBlock = string.format("[%s] [Call #%d] game.%s:%s(%s)", timestamp, Config.CapturedPaths[remotePath], remotePath, method, table.concat(formattedArgs, ", "))
                    end

                    table.insert(Config.CapturedLogs, logBlock)
                    if Config.LogToConsole then print("[Zentih Trace]:\n" .. logBlock) end
                end

                if Config.BlockNetworkServer then
                    return nil
                end
            end

            return oldNamecall(self, ...)
        end))

        setreadonly(grm, true)
    end)
end

