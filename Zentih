local function CreateCleanToggleBtn()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ZentihCleanToggleGui"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true

    if gethui then
        ScreenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(ScreenGui)
        ScreenGui.Parent = CoreGui
    else
        local parentOk = pcall(function() ScreenGui.Parent = CoreGui end)
        if not parentOk then ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    end

    local Frame = Instance.new("Frame")
    Frame.Name = "CleanToggleButtonFrame"
    Frame.Size = UDim2.fromOffset(52, 52)
    Frame.Position = UDim2.new(0.02, 0, 0.25, 0)
    Frame.BackgroundTransparency = 1
    Frame.BorderSizePixel = 0
    Frame.Active = true
    Frame.Parent = ScreenGui

    local LogoBtn = Instance.new("ImageButton")
    LogoBtn.Name = "LogoBtn"
    LogoBtn.Size = UDim2.fromScale(1, 1)
    LogoBtn.Position = UDim2.fromScale(0, 0)
    LogoBtn.BackgroundTransparency = 1
    LogoBtn.BorderSizePixel = 0
    LogoBtn.Image = LogoAsset
    LogoBtn.Parent = Frame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(1, 0)
    BtnCorner.Parent = LogoBtn

    local dragging, dragInput, dragStart, startPos
    local function update(input)
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    Frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then update(input) end
    end)

    LogoBtn.MouseButton1Click:Connect(function()
        pcall(function() Window:Toggle() end)
    end)
end

