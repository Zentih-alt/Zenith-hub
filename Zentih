    if Config.DumpReplicatedFirst then table.insert(services, game:GetService("ReplicatedFirst")) end
    return services
end

-- ระบบบันทึกไฟล์อัจฉริยะ (ขนาดสูงสุด 22 MB)
local function SaveSmartFile(baseName, contentLines)
    local cleanName = sanitizeFileName(baseName:gsub("%.txt$", ""))
    local MAX_BYTES = 22 * 1024 * 1024
    local part = 1
    local currentChunk = {}
    local currentSize = 0
    local savedFilesCount = 0
    
    for i = 1, #contentLines do
        local line = contentLines[i]
        local lineSize = #line + 1
        if currentSize + lineSize > MAX_BYTES then
            local filePath = string.format("%s/%s_Part%d.txt", HubFolderName, cleanName, part)
            if writefile then
                pcall(function() writefile(filePath, table.concat(currentChunk, "\n")) end)
                savedFilesCount = savedFilesCount + 1
            end
            part = part + 1
            currentChunk = {"=== ต่อจากไฟล์ Part " .. (part - 1) .. " ===\n"}
            currentSize = #currentChunk[1]
        end
        table.insert(currentChunk, line)
        currentSize = currentSize + lineSize
    end
    
    if #currentChunk > 0 then
        local suffix = part > 1 and ("_Part" .. part) or ""
        local filePath = string.format("%s/%s%s.txt", HubFolderName, cleanName, suffix)
        if writefile then
            local successSave = pcall(function() writefile(filePath, table.concat(currentChunk, "\n")) end)
            if successSave then savedFilesCount = savedFilesCount + 1 end
        elseif setclipboard then
            pcall(function() setclipboard(table.concat(currentChunk, "\n")) end)
        end
    end
    
    return part
end

