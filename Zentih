            table.insert(buffer, "=== ZENITH SOUL HUB : CLEAN DEX DUMP FOR AI ===\n")
            table.insert(buffer, "Place ID : " .. tostring(game.PlaceId) .. "\n\n")

            local services = {}
            if Config.SearchLocation == "All" then
