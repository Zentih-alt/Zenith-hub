-- 2. ระบบบันทึกไฟล์ (Smart Saver)
--------------------------------------------------------------------------------
local function SaveFile(filename, contentTable, windowInstance)
    if not string.match(filename, "%.txt$") and not string.match(filename, "%.lua$") then
        filename = filename .. ".txt"
    end

    local path = FOLDER_NAME .. "/" .. filename

    if writefile then
        local writeSuccess = pcall(function()
            writefile(path, table.concat(contentTable))
        end)

        if writeSuccess and windowInstance then
            windowInstance:Notify({
                Title = "System Notification",
                Content = "Saved: " .. path,
                Duration = 3
            })
        end
    end
end

