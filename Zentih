-- ฟังก์ชันดึงรายชื่อไฟล์ Config .json
local function getFileList()
    local list = {}
    if listfiles and isfolder and isfolder(HubFolderName) then
        for _, file in ipairs(listfiles(HubFolderName)) do
            local name = file:match("([^/\\]+)$")
            if name and name:match("%.json$") then
                table.insert(list, name:gsub("%.json$", ""))
            end
        end
    end
    return #list > 0 and list or {"Default_Config"}
end

