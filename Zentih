-- ระบบ Smart File Saver (แยกไฟล์อัตโนมัติเมื่อขนาดเกิน 8.5MB)
local function SaveSmartFile(baseName, contentLines)
    local rawName = baseName:gsub("%.txt$", "")
    local MAX_BYTES = 8.5 * 1024 * 1024 -- 8.5MB Safe Threshold
    local part = 1
    local currentChunk = {}
    local currentSize = 0
    
    for _, line in ipairs(contentLines) do
        local lineSize = #line + 1
        if currentSize + lineSize > MAX_BYTES then
            local filePath = string.format("%s/%s_Part%d.txt", HubFolderName, rawName, part)
            if writefile then writefile(filePath, table.concat(currentChunk, "\n")) end
            part = part + 1
            currentChunk = {"=== ต่อจากไฟล์ Part " .. (part - 1) .. " ===\n"}
            currentSize = #currentChunk[1]
        end
        table.insert(currentChunk, line)
        currentSize = currentSize + lineSize
    end
    
    if #currentChunk > 0 then
        local suffix = part > 1 and ("_Part" .. part) or ""
        local filePath = string.format("%s/%s%s.txt", HubFolderName, rawName, suffix)
        if writefile then writefile(filePath, table.concat(currentChunk, "\n")) end
    end
    
    return part
end

