-- 5. PLAYER INVENTORY & UI DATA (ข้อมูลผู้เล่น & โครงสร้าง PlayerGui)
-- ==========================================================
local function scanPlayerAndUIData()
    local uiLines = {
        "\n========================================",
        "LAYER 5: PLAYER INVENTORY & UI DATA",
        "========================================"
    }

    -- 1. สแกน leaderstats & Attributes
    table.insert(uiLines, "--- Player Leaderstats & Attributes ---")
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, val in ipairs(leaderstats:GetChildren()) do
            if val:IsA("ValueObject") then
                table.insert(uiLines, string.format("[LEADERSTAT] %s = %s", val.Name, tostring(val.Value)))
            end
        end
    end

    pcall(function()
        local attributes = LocalPlayer:GetAttributes()
        for k, v in pairs(attributes) do
            table.insert(uiLines, string.format("[ATTRIBUTE] %s = %s", tostring(k), tostring(v)))
        end
    end)

    -- 2. สแกนโครงสร้าง PlayerGui
    table.insert(uiLines, "\n--- PlayerGui Active Elements ---")
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if pGui then
        local uiCount = 0
        for _, screenGui in ipairs(pGui:GetChildren()) do
            if screenGui:IsA("ScreenGui") and screenGui.Enabled then
                uiCount = uiCount + 1
                table.insert(uiLines, string.format("\n[ScreenGui] game.Players.LocalPlayer.PlayerGui.%s", screenGui.Name))
                for _, btn in ipairs(screenGui:GetDescendants()) do
                    if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                        local text = btn:IsA("TextButton") and btn.Text or btn.Name
                        table.insert(uiLines, string.format("  ├── [Button] Name: '%s' | Text: '%s' | Path: game.%s", btn.Name, text, btn:GetFullName()))
                    end
                end
            end
        end
    end

    return uiLines
end

