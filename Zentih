-- 3. ระบบวิเคราะห์ปุ่มและรีโมทเชิงลึก (Deep Asset & Remote Linker)
--------------------------------------------------------------------------------
local function AnalyzeAssetDetails(item)
    local className = item.ClassName
    local details = ""

    -- 1. Remote Signals
    if className == "RemoteEvent" or className == "RemoteFunction" or className == "BindableEvent" or className == "BindableFunction" then
        return true, "REMOTE", "Path: game." .. item:GetFullName()

    -- 2. Interactive Buttons (ปุ่มกดหน้าจอ)
    elseif item:IsA("TextButton") or item:IsA("ImageButton") then
        local buttonText = item:IsA("TextButton") and item.Text or item.Name
        local boundRemotes = {}

        -- ค้นหา RemoteEvent หรือ LocalScript ที่ซ่อนอยู่ใต้ปุ่ม
        for _, child in ipairs(item:GetDescendants()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                table.insert(boundRemotes, child:GetFullName())
            end
        end

        details = "Label: '" .. tostring(buttonText) .. "'"
        if #boundRemotes > 0 then
            details = details .. " | Linked Remotes: [" .. table.concat(boundRemotes, ", ") .. "]"
        end
        return true, "UI_BUTTON", details

    -- 3. Prompts & Triggers (ปุ่มกด E / จุดแตะ)
    elseif className == "ProximityPrompt" then
        details = string.format("Action: '%s', Object: '%s', Duration: %.1fs", item.ActionText, item.ObjectText, item.HoldDuration)
        return true, "INTERACTION", details
    elseif className == "TouchInterest" or className == "TouchTransmitter" then
        local parentName = item.Parent and item.Parent.Name or "Unknown"
        return true, "TOUCH_ZONE", "Trigger Part: " .. parentName

    -- 4. Value Data
    elseif item:IsA("ValueBase") then
        return true, "VALUE", "Value: " .. tostring(item.Value)

    -- 5. Scripts & Modules
    elseif className == "LocalScript" or className == "ModuleScript" or className == "Script" then
        return true, "SCRIPT", "Type: " .. className

    -- 6. Tools & NPCs
    elseif item:IsA("Tool") then
        return true, "TOOL", "Tool Name: " .. item.Name
    elseif className == "Humanoid" and item.Parent then
        local root = item.Parent:FindFirstChild("HumanoidRootPart")
        if root then
            local pos = root.Position
            details = string.format("NPC Position: Vector3.new(%.1f, %.1f, %.1f)", pos.X, pos.Y, pos.Z)
        else
            details = "Entity: " .. item.Parent.Name
        end
        return true, "NPC", details
    end

    return false, nil, nil
end

