-- 🛠️ ENGINE 1: MAP & 5-LAYER FAST STRUCTURE DUMPER
-- ==========================================================
local function serializeTable(val, indentLevel, visited)
    visited = visited or {}
    indentLevel = indentLevel or 1
    if indentLevel > 4 then return "{...}" end
    local indent = string.rep("\t", indentLevel)
    local t = typeof(val)

    if t == "string" then
        return '"' .. tostring(val) .. '"'
    elseif t == "Instance" then
        local fullPath = "Instance"
        pcall(function() fullPath = 'game.' .. val:GetFullName() end)
        return fullPath
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.2f, %.2f, %.2f)", val.X, val.Y, val.Z)
    elseif t == "CFrame" then
        return string.format("CFrame.new(%.2f, %.2f, %.2f)", val.Position.X, val.Position.Y, val.Position.Z)
    elseif t == "table" then
        if visited[val] then return "{...}" end
        visited[val] = true
        
        local isArray = true
        local maxIndex = 0
        for k, v in pairs(val) do
            if type(k) == "number" and k > 0 and math.floor(k) == k then
                if k > maxIndex then maxIndex = k end
            else
                isArray = false
            end
        end
        if #val ~= maxIndex then isArray = false end

        local entries = {}
        if isArray then
            for i, v in ipairs(val) do
                table.insert(entries, serializeTable(v, indentLevel + 1, visited))
                if i > 50 then table.insert(entries, "... (Truncated)"); break end
            end
            if #entries <= 3 then
                return "{ " .. table.concat(entries, ", ") .. " }"
            else
                return "{\n" .. indent .. "\t" .. table.concat(entries, ",\n" .. indent .. "\t") .. "\n" .. indent .. "}"
            end
        else
            local count = 0
            for k, v in pairs(val) do
                count = count + 1
                if count > 50 then table.insert(entries, "[\"...\"] = \"Truncated\""); break end
                local keyStr = type(k) == "string" and ('["' .. k .. '"]') or ("[" .. tostring(k) .. "]")
                table.insert(entries, keyStr .. " = " .. serializeTable(v, indentLevel + 1, visited))
            end
            return "{\n" .. indent .. "\t" .. table.concat(entries, ",\n" .. indent .. "\t") .. "\n" .. indent .. "}"
        end
    else
        return tostring(val)
    end
end

-- Layer 2: Data Modules Scanner (SAFE SAFE INSPECTION - แก้ไข Error Line 272)
local function scanDataModules(outputLines)
    table.insert(outputLines, "\n========================================")
    table.insert(outputLines, "LAYER 2: DATA MODULES & CONFIG TABLES")
    table.insert(outputLines, "========================================")
    
    local count = 0
    local targetKeywords = {"shop", "tower", "unit", "map", "item", "config", "data", "stage", "raid"}

    -- สแกนเฉพาะพื้นที่สาธารณะ ป้องกันการโดน CorePackages / CoreGui สิทธิ์ RobloxScript
    local safeScanTargets = {
        ReplicatedStorage,
        ReplicatedFirst,
        LocalPlayer:FindFirstChild("PlayerGui"),
        game:GetService("StarterPlayer")
    }

    for _, targetParent in ipairs(safeScanTargets) do
        if targetParent then
            pcall(function()
                local descendants = targetParent:GetDescendants()
                for i = 1, #descendants do
                    local obj = descendants[i]
                    if obj:IsA("ModuleScript") then
                        pcall(function()
                            local lowerName = string.lower(obj.Name)
                            local isMatch = false
                            for _, kw in ipairs(targetKeywords) do
                                if lowerName:find(kw) then
                                    isMatch = true
                                    break
                                end
                            end

                            if isMatch then
                                local reqSuccess, reqData = pcall(require, obj)
                                if reqSuccess and type(reqData) == "table" then
                                    count = count + 1
                                    table.insert(outputLines, string.format("\n-- Module [%d]: game.%s", count, obj:GetFullName()))
                                    table.insert(outputLines, "local " .. sanitizeFileName(obj.Name) .. "Data = " .. serializeTable(reqData, 1))
                                end
                            end
                        end)
                    end
                    if i % 300 == 0 then task.wait() end
                end
            end)
        end
    end
    table.insert(outputLines, "-- Total Executed Modules: " .. tostring(count))
end

-- Layer 3: GC RAM Memory Scanner
local function scanGCMemory(outputLines)
    table.insert(outputLines, "\n========================================")
    table.insert(outputLines, "LAYER 3: GARBAGE COLLECTOR & RAM MEMORY")
    table.insert(outputLines, "========================================")
    local count = 0

    if getgc then
        pcall(function()
            local gcList = getgc(true)
            for i = 1, #gcList do
                pcall(function()
                    local item = gcList[i]
                    if typeof(item) == "Instance" and (item:IsA("RemoteEvent") or item:IsA("RemoteFunction")) then
                        if not item.Parent then
                            count = count + 1
                            table.insert(outputLines, string.format("[%04d] [UNPARENTED REMOTE] [%s] %s -> game.%s", count, item.ClassName, item.Name, item:GetFullName()))
                        end
                    end
                end)
                if i % 3000 == 0 then task.wait() end
            end
        end)
        table.insert(outputLines, "-- Total GC Memory Remotes: " .. tostring(count))
    else
        table.insert(outputLines, "-- Executor ของคุณไม่รองรับ getgc()")
    end
end

