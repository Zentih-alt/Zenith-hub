TabDump:CreateButton({
    Title = "Extract Clean Scripting Data",
    Callback = function()
        task.spawn(function()
            local buffer = {}
            table.insert(buffer, "==================================================\n")
            table.insert(buffer, "=== ZENITH SOUL HUB : CLEAN SCRIPTING DUMP ===\n")
            table.insert(buffer, "==================================================\n")
            table.insert(buffer, "Place ID : " .. tostring(game.PlaceId) .. "\n")
            table.insert(buffer, "Date     : " .. os.date("%Y-%m-%d %X") .. "\n\n")

            local services = {}
            if Config.TargetService == "All" then
                services = {game.ReplicatedStorage, game.Workspace, game.StarterGui, game.StarterPack, game.Players}
            else
                local targetServ = game:GetService(Config.TargetService)
                if targetServ then table.insert(services, targetServ) end
            end

            local categories = {
                REMOTE = {},
                UI_BUTTON = {},
                INTERACTION = {},
                SCRIPT = {},
                VALUE = {},
                GAMEPLAY = {}
            }

            for _, serv in ipairs(services) do
                if serv then
                    local descendants = serv:GetDescendants()
                    for i = 1, #descendants do
                        local item = descendants[i]
                        local isTarget, category, details = AnalyzeAssetDetails(item)

                        if isTarget then
                            local line = string.format("game.%s (%s)", item:GetFullName(), item.ClassName)
                            if details and details ~= "" then
                                line = line .. " | " .. details
                            end

                            if categories[category] then
                                table.insert(categories[category], line)
                            else
                                table.insert(categories.GAMEPLAY, line)
                            end
                        end
                        if i % 1000 == 0 then task.wait() end
                    end
                end
            end

            -- เขียนลงไฟล์แยกตามหมวดหมู่อย่างเป็นระเบียบ
            for catName, items in pairs(categories) do
                if #items > 0 then
                    table.insert(buffer, "--- [" .. catName .. " SAMPLES] (" .. #items .. " Items) ---\n")
                    for _, entry in ipairs(items) do
                        table.insert(buffer, entry .. "\n")
                    end
                    table.insert(buffer, "\n")
                end
            end

            SaveFile(Config.MainFilename, buffer, Window)
        end)
    end
})

