-- 🛠️ COMPREHENSIVE 5-LAYER ANALYZER EXECUTION
-- ==========================================================
local function generateFull5LayerAnalysis()
    local lines = {
        "-- ========================================",
        "-- ZENTIH HUB: COMPREHENSIVE 5-LAYER ANALYSIS DATA",
        "-- Place ID: " .. tostring(game.PlaceId),
        "-- Date: " .. os.date("%Y-%m-%d %H:%M:%S"),
        "-- ========================================\n"
    }

    -- ชั้น 1: Network & Remotes
    if Config.SwitchRemotes then
        table.insert(lines, "========================================")
        table.insert(lines, "LAYER 1: REMOTE & NETWORK LAYER")
        table.insert(lines, "========================================")
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("UnreliableRemoteEvent") then
                table.insert(lines, string.format("[%s] game.%s", obj.ClassName, obj:GetFullName()))
            end
        end
    end

    -- ชั้น 2: Data Modules
    if Config.SwitchModules then
        local moduleLines = scanDataModules()
        for _, l in ipairs(moduleLines) do table.insert(lines, l) end
    end

    -- ชั้น 3: GC RAM Memory
    if Config.SwitchMemory then
        local gcLines = scanGCMemory()
        for _, l in ipairs(gcLines) do table.insert(lines, l) end
    end

    -- ชั้น 4: Map & Workspace Interactive Objects
    if Config.SwitchMapPositions then
        local mapLines = scanWorkspacePositions()
        for _, l in ipairs(mapLines) do table.insert(lines, l) end
    end

    -- ชั้น 5: Player Inventory & UI Data
    if Config.SwitchUI then
        local uiLines = scanPlayerAndUIData()
        for _, l in ipairs(uiLines) do table.insert(lines, l) end
    end

    return lines
end

