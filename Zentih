-- 🛠️ ENGINE 1: MAP & 5-LAYER STRUCTURE DUMPER
-- ==========================================================
local function serializeTable(val, indentLevel, visited)
    visited = visited or {}
    indentLevel = indentLevel or 1
    local indent = string.rep("\t", indentLevel)
    local t = typeof(val)

    if t == "string" then
        return '"' .. tostring(val) .. '"'
    elseif t == "Instance" then
        return 'game.' .. val:GetFullName()
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.2f, %.2f, %.2f)", val.X, val.Y, val.Z)
    elseif t == "CFrame" then
        return string.format("CFrame.new(%.2f, %.2f, %.2f)", val.Position.X, val.Position.Y, val.Position.Z)
    elseif t == "table" then
        if visited[val] then return "{...}" end
        visited[val] = true
        
        local isArray = true
        local maxIndex = 0
        for k, v in pairs(val) do
            if type(k) == "number" and k > 0 and math.floor(k) == k then
                if k > maxIndex then maxIndex = k end
            else
                isArray = false
            end
        end
        if #val ~= maxIndex then isArray = false end

        local entries = {}
        if isArray then
            for i, v in ipairs(val) do
                table.insert(entries, serializeTable(v, indentLevel + 1, visited))
            end
            if #entries <= 3 then
                return "{ " .. table.concat(entries, ", ") .. " }"
            else
                return "{\n" .. indent .. "\t" .. table.concat(entries, ",\n" .. indent .. "\t") .. "\n" .. indent .. "}"
            end
        else
            for k, v in pairs(val) do
                local keyStr = type(k) == "string" and ('["' .. k .. '"]') or ("[" .. tostring(k) .. "]")
                table.insert(entries, keyStr .. " = " .. serializeTable(v, indentLevel + 1, visited))
            end
            return "{\n" .. indent .. "\t" .. table.concat(entries, ",\n" .. indent .. "\t") .. "\n" .. indent .. "}"
        end
    else
        return tostring(val)
    end
end

-- Layer 2: Data Modules Scanner
local function scanDataModules()
    local moduleLines = {
        "\n========================================",
        "LAYER 2: DATA MODULES & CONFIG TABLES",
        "========================================"
    }
    local count = 0
    local targetKeywords = {"shop", "tower", "unit", "map", "item", "config", "data", "stage", "raid"}

    for _, obj in ipairs(game:GetDescendants()) do
        if obj:IsA("ModuleScript") then
            local lowerName = string.lower(obj.Name)
            local isMatch = false
            for _, kw in ipairs(targetKeywords) do
                if lowerName:find(kw) then
                    isMatch = true
                    break
                end
            end

            if isMatch then
                pcall(function()
                    local reqData = require(obj)
                    if type(reqData) == "table" then
                        count = count + 1
                        table.insert(moduleLines, string.format("\n-- Module [%d]: game.%s", count, obj:GetFullName()))
                        table.insert(moduleLines, "local " .. obj.Name .. "Data = " .. serializeTable(reqData, 1))
                    end
                end)
            end
        end
    end
    table.insert(moduleLines, 1, "-- Total Executed Modules: " .. tostring(count))
    return moduleLines
end

-- Layer 3: GC RAM Memory Scanner
local function scanGCMemory()
    local gcLines = {
        "\n========================================",
        "LAYER 3: GARBAGE COLLECTOR & RAM MEMORY",
        "========================================"
    }
    local count = 0

    if getgc then
        local gcList = getgc(true)
        for _, item in ipairs(gcList) do
            if type(item) == "table" and rawget(item, "FireServer") then
                count = count + 1
                table.insert(gcLines, string.format("[%04d] Found Custom Network Table in RAM Memory", count))
            elseif typeof(item) == "Instance" and (item:IsA("RemoteEvent") or item:IsA("RemoteFunction")) then
                if not item.Parent then
                    count = count + 1
                    table.insert(gcLines, string.format("[%04d] [UNPARENTED REMOTE] [%s] %s -> game.%s", count, item.ClassName, item.Name, item:GetFullName()))
                end
            end
        end
        table.insert(gcLines, 1, "-- Total GC Memory Items: " .. tostring(count))
    else
        table.insert(gcLines, "-- Executor ของคุณไม่รองรับ getgc()")
    end

    return gcLines
end

-- Layer 4: Map & Workspace Interactive Objects
local function scanWorkspacePositions()
    local mapLines = {
        "\n========================================",
        "LAYER 4: WORKSPACE & INTERACTIVE POSITIONS",
        "========================================"
    }
    local count = 0

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            if lowerName:find("tp") or lowerName:find("teleport") or lowerName:find("pad") or lowerName:find("zone") or lowerName:find("pod") or lowerName:find("door") then
                count = count + 1
                local pos = obj.Position
                table.insert(mapLines, string.format("[ZONE/PAD] Path: game.%s | Vector3.new(%.2f, %.2f, %.2f) | CFrame = CFrame.new(%.2f, %.2f, %.2f)",
                    obj:GetFullName(), pos.X, pos.Y, pos.Z, pos.X, pos.Y, pos.Z))
            end
        end
    end

    pcall(function()
        table.insert(mapLines, "\n--- CollectionService Tagged Objects ---")
        local tags = {"Monster", "Enemy", "Tower", "SpawnPoint", "Spot", "UnitSpot"}
        for _, tag in ipairs(tags) do
            local taggedObjects = CollectionService:GetTagged(tag)
            if #taggedObjects > 0 then
                table.insert(mapLines, string.format("\nTag: '%s' (%d Objects Found):", tag, #taggedObjects))
                for i, tObj in ipairs(taggedObjects) do
                    if tObj:IsA("BasePart") then
                        local pos = tObj.Position
                        table.insert(mapLines, string.format("  [%d] game.%s | Vector3.new(%.2f, %.2f, %.2f)", i, tObj:GetFullName(), pos.X, pos.Y, pos.Z))
                    else
                        table.insert(mapLines, string.format("  [%d] game.%s (%s)", i, tObj:GetFullName(), tObj.ClassName))
                    end
                end
            end
        end
    end)

    table.insert(mapLines, 1, "-- Total Map Positions Found: " .. tostring(count))
    return mapLines
end

