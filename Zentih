-- 🛠️ ENGINE 1: UNIVERSAL TREE DUMPER (ระบบรางไม้ดัมป์แมพ)
-- ==========================================================
local function generateTreeDump()
    local dumpText = "-- ========================================\n"
    dumpText = dumpText .. "-- ZENTIH HUB: UNIVERSAL GAME DUMP DATA\n"
    dumpText = dumpText .. "-- Place ID: " .. tostring(game.PlaceId) .. "\n"
    dumpText = dumpText .. "-- Date: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n"
    dumpText = dumpText .. "-- Format: " .. Config.TreeStyle .. "\n"
    dumpText = dumpText .. "-- ========================================\n\n"

    local function dumpNode(object, depth, isLast, prefix)
        depth = depth or 0
        if depth > Config.MaxDepth then return "" end

        prefix = prefix or ""
        local text = ""
        local currentBranch = ""
        local nextPrefix = ""

        local className = object.ClassName
        local name = object.Name

        -- กรองประเภทวัตถุ
        if Config.FilterType == "เฉพาะ Remote" then
            if not (className == "RemoteEvent" or className == "UnreliableRemoteEvent" or className == "RemoteFunction") then
                local hasRemoteChild = false
                for _, child in ipairs(object:GetChildren()) do
                    if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                        hasRemoteChild = true
                        break
                    end
                end
                if not hasRemoteChild then return "" end
            end
        elseif Config.FilterType == "เฉพาะ ModuleScript" then
            if className ~= "ModuleScript" and #object:GetChildren() == 0 then
                return ""
            end
        end

        -- การสร้างรูปแบบกิ่งก้านรางไม้
        if Config.TreeStyle == "Railway (├──)" then
            currentBranch = isLast and "└── " or "├── "
            nextPrefix = prefix .. (isLast and "    " or "│   ")
        elseif Config.TreeStyle == "Short Code" then
            currentBranch = string.rep("  ", depth)
            nextPrefix = ""
        else
            currentBranch = string.rep("- ", depth)
            nextPrefix = ""
        end

        local tag = "[" .. className .. "]"
        if className == "RemoteEvent" or className == "UnreliableRemoteEvent" then
            tag = "[RemoteEvent ⚡]"
        elseif className == "RemoteFunction" then
            tag = "[RemoteFunction 🔄]"
        elseif className == "ModuleScript" then
            tag = "[ModuleScript 📜]"
        elseif className == "LocalScript" then
            tag = "[LocalScript 📝]"
        end

        text = text .. prefix .. currentBranch .. tag .. " " .. name

        -- บันทึก Path และค่าพารามิเตอร์เบื้องต้น
        if className == "RemoteEvent" or className == "RemoteFunction" or className == "UnreliableRemoteEvent" then
            text = text .. " -> Path: game." .. object:GetFullName()
        elseif object:IsA("ValueObject") then
            pcall(function()
                text = text .. " (Value: " .. tostring(object.Value) .. ")"
            end)
        end

        -- ดึง Attributes ถ้าเปิดใช้งาน
        if Config.DumpAttributes then
            pcall(function()
                local attributes = object:GetAttributes()
                local attrStrs = {}
                for k, v in pairs(attributes) do
                    table.insert(attrStrs, tostring(k) .. "=" .. tostring(v))
                end
                if #attrStrs > 0 then
                    text = text .. " {Attributes: " .. table.concat(attrStrs, ", ") .. "}"
                end
            end)
        end

        text = text .. "\n"

        local children = object:GetChildren()
        for i, child in ipairs(children) do
            local childIsLast = (i == #children)
            text = text .. dumpNode(child, depth + 1, childIsLast, nextPrefix)
        end

        return text
    end

    local services = getSelectedServices()
    for _, service in ipairs(services) do
        pcall(function()
            dumpText = dumpText .. "\n========================================\n"
            dumpText = dumpText .. "SERVICE: " .. service.Name .. "\n"
            dumpText = dumpText .. "========================================\n"
            local children = service:GetChildren()
            for i, child in ipairs(children) do
                dumpText = dumpText .. dumpNode(child, 0, i == #children, "")
            end
        end)
    end

    return dumpText
end

