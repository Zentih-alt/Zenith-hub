-- 🛡️ METAMETHOD HOOKING (DUAL MODE ENGINE)
local checkcaller = checkcaller or function() return false end
local newcclosure = newcclosure or function(f) return f end

if hookmetamethod and getrawmetatable then
    pcall(function()
        local grm = getrawmetatable(game)
        local setreadonly = setreadonly or make_writeable or function() end
        local oldNamecall

        setreadonly(grm, false)

        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            if not checkcaller() and Config.RemoteSpyActive then
                if method == "FireServer" or method == "InvokeServer" then
                    pcall(function()
                        local remotePath = self:GetFullName()
                        local formattedArgs = ""
                        for i = 1, #args do
                            local arg = args[i]
                            if type(arg) == "table" then
                                formattedArgs = formattedArgs .. "{Table}"
                            elseif typeof(arg) == "Instance" then
                                formattedArgs = formattedArgs .. "Instance(" .. arg:GetFullName() .. ")"
                            elseif type(arg) == "string" then
                                formattedArgs = formattedArgs .. "'" .. tostring(arg) .. "'"
                            else
                                formattedArgs = formattedArgs .. tostring(arg)
                            end
                            if i < #args then formattedArgs = formattedArgs .. ", " end
                        end

                        local modeTag = Config.BlockRemoteServer and "[BLOCKED]" or "[NORMAL]"
                        local logEntry = string.format("%s game.%s:%s(%s)\n", modeTag, remotePath, method, formattedArgs)
                        table.insert(Config.LoggedRemotes, logEntry)
                    end)

                    -- ถ้าเปิดโหมด Block จะคืนค่า nil ทันที (ไม่ส่งสัญญาณไปหาเกม)
                    if Config.BlockRemoteServer then
                        return nil
                    end
                end
            end

            return oldNamecall(self, ...)
        end))

        setreadonly(grm, true)
    end)
end

