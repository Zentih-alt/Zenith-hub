-- 🛠️ ENGINE 1: FULL DEEP TREE DUMPER (ดัมพ์แมพแบบไม่ตัดขยะ)
-- ==========================================================
local function generateTreeDump()
    local lines = {
        "-- ========================================",
        "-- ZENTIH HUB: FULL DEEP GAME DUMP DATA",
        "-- Place ID: " .. tostring(game.PlaceId),
        "-- Date: " .. os.date("%Y-%m-%d %H:%M:%S"),
        "-- Format: " .. Config.TreeStyle,
        "-- ========================================\n"
    }

    local totalObjectsCount = 0

    local function dumpNode(object, depth, isLast, prefix)
        depth = depth or 0
        if not Config.UnlimitedDepth and depth > Config.MaxDepth then return end

        prefix = prefix or ""
        local currentBranch = ""
        local nextPrefix = ""

        if Config.TreeStyle == "Railway (├──)" then
            currentBranch = isLast and "└── " or "├── "
            nextPrefix = prefix .. (isLast and "    " or "│   ")
        elseif Config.TreeStyle == "Short Code" then
            currentBranch = string.rep("  ", depth)
            nextPrefix = ""
        else
            currentBranch = string.rep("- ", depth)
            nextPrefix = ""
        end

        local className = object.ClassName
        local name = object.Name

        local isRemote = className:find("Remote") or className:find("Bindable")
        local isUI = className:find("Button") or className == "ProximityPrompt" or className == "ClickDetector" or className == "ScreenGui"
        local isAsset = not isRemote and not isUI

        local shouldShow = true
        if isRemote and not Config.SwitchRemotes then shouldShow = false end
        if isUI and not Config.SwitchUI then shouldShow = false end
        if isAsset and not Config.SwitchGameAssets then shouldShow = false end

        if Config.FilterType == "เฉพาะ Remote" and not isRemote then
            shouldShow = false
        elseif Config.FilterType == "เฉพาะ ModuleScript" and className ~= "ModuleScript" then
            shouldShow = false
        end

        if shouldShow then
            totalObjectsCount = totalObjectsCount + 1
            local tag = "[" .. className .. "]"
            if className:find("RemoteEvent") then tag = "[RemoteEvent ⚡]"
            elseif className:find("RemoteFunction") then tag = "[RemoteFunction 🔄]"
            elseif className == "ModuleScript" then tag = "[ModuleScript 📜]"
            elseif className == "LocalScript" then tag = "[LocalScript 📝]"
            end

            local line = prefix .. currentBranch .. tag .. " " .. name

            if className:find("Remote") then
                line = line .. " -> Path: game." .. object:GetFullName()
            elseif object:IsA("ValueObject") then
                pcall(function() line = line .. " (Value: " .. tostring(object.Value) .. ")" end)
            elseif object:IsA("TextButton") then
                line = line .. " (Text: '" .. object.Text .. "')"
            end

            if Config.DumpAttributes then
                pcall(function()
                    local attributes = object:GetAttributes()
                    local attrStrs = {}
                    for k, v in pairs(attributes) do
                        table.insert(attrStrs, tostring(k) .. "=" .. tostring(v))
                    end
                    if #attrStrs > 0 then
                        line = line .. " {Attributes: " .. table.concat(attrStrs, ", ") .. "}"
                    end
                end)
            end

            table.insert(lines, line)
        end

        -- สแกนต่อลงไปในชั้นลูกเสมอ
        local children = object:GetChildren()
        for i, child in ipairs(children) do
            dumpNode(child, depth + 1, i == #children, nextPrefix)
        end
    end

    local services = getSelectedServices()
    for _, service in ipairs(services) do
        pcall(function()
            table.insert(lines, "\n========================================\nSERVICE: " .. service.Name .. "\n========================================")
            local children = service:GetChildren()
            for i, child in ipairs(children) do
                dumpNode(child, 0, i == #children, "")
            end
        end)
    end

    if Config.DumpNilInstances and getnilinstances then
        pcall(function()
            table.insert(lines, "\n========================================\nSERVICE: NilInstances (Memory Objects)\n========================================")
            local nilList = getnilinstances()
            for i, obj in ipairs(nilList) do
                pcall(function()
                    if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("ModuleScript") then
                        totalObjectsCount = totalObjectsCount + 1
                        table.insert(lines, string.format("[NIL MEMORY] [%s] %s (Parent: %s)", obj.ClassName, obj.Name, obj.Parent and obj.Parent:GetFullName() or "Nil"))
                    end
                end)
            end
        end)
    end

    table.insert(lines, 1, "-- Total Extracted Objects: " .. tostring(totalObjectsCount))
    return lines
end

