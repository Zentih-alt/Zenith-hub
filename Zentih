-- แปลงชนิดพารามิเตอร์เชิงลึก (Deep Argument Serializer)
local function serializeArg(val, visited)
    visited = visited or {}
    local t = typeof(val)
    if t == "string" then
        return '"' .. tostring(val) .. '"'
    elseif t == "Instance" then
        return "game." .. val:GetFullName()
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.2f, %.2f, %.2f)", val.X, val.Y, val.Z)
    elseif t == "CFrame" then
        return string.format("CFrame.new(%.2f, %.2f, %.2f)", val.Position.X, val.Position.Y, val.Position.Z)
    elseif t == "Color3" then
        return string.format("Color3.fromRGB(%d, %d, %d)", math.floor(val.R * 255), math.floor(val.G * 255), math.floor(val.B * 255))
    elseif t == "UDim2" then
        return string.format("UDim2.new(%.2f, %d, %.2f, %d)", val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset)
    elseif t == "EnumItem" then
        return tostring(val)
    elseif t == "table" then
        if visited[val] then return "{... (Circular Table)}" end
        visited[val] = true
        
        local pairsStr = {}
        for k, v in pairs(val) do
            local keyStr = typeof(k) == "string" and ('["' .. k .. '"]') or ("[" .. tostring(k) .. "]")
            table.insert(pairsStr, keyStr .. " = " .. serializeArg(v, visited))
        end
        return "{" .. table.concat(pairsStr, ", ") .. "}"
    else
        return tostring(val)
    end
end

-- Metatable Hooking สำหรับดักจับ Remote สัญญาณตรงจากทุกแมพ
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if Config.RemoteSpyEnabled and (method == "FireServer" or method == "InvokeServer" or method == "Fire" or method == "Invoke") then
        local remotePath = self:GetFullName()
        
        -- กรองสัญญาณขยะที่ไม่จำเป็น
        local isIgnored = false
        if Config.IgnoreMovement and (string.find(remotePath, "Move") or string.find(remotePath, "Position") or string.find(remotePath, "Physics") or string.find(remotePath, "Walk")) then
            isIgnored = true
        end
        if Config.IgnoreChat and (string.find(remotePath, "Chat") or string.find(remotePath, "SayMessage") or string.find(remotePath, "Bubble")) then
            isIgnored = true
        end
        if Config.IgnoreAnims and (string.find(remotePath, "HandleAnimations") or string.find(remotePath, "Animate") or string.find(remotePath, "Ping")) then
            isIgnored = true
        end

        if not isIgnored then
            Config.TotalCalls = Config.TotalCalls + 1
            Config.CapturedRemotePaths[remotePath] = (Config.CapturedRemotePaths[remotePath] or 0) + 1

            -- ตรวจจับสคริปต์ผู้สั่งงาน (Trace Calling Script)
            local callerScript = "Unknown Script"
            if getcallingscript then
                local s = getcallingscript()
                if s then callerScript = s:GetFullName() end
            end

            local formattedArgs = {}
            for i, arg in ipairs(args) do
                formattedArgs[i] = serializeArg(arg)
            end

            local timestamp = os.date("%H:%M:%S")
            local logLine = string.format("[%s] [Call #%d] [Called By: game.%s] game.%s:%s(%s)", 
                timestamp, Config.CapturedRemotePaths[remotePath], callerScript, remotePath, method, table.concat(formattedArgs, ", "))
            
            table.insert(Config.CapturedRemotes, logLine)

            if Config.LogToConsole then
                print("[Zentih RemoteSpy #" .. Config.TotalCalls .. "]: " .. logLine)
            end
        end
    end

    return oldNamecall(self, ...)
end)

