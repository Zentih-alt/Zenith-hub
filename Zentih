-- Metamethod Hooking
local checkcaller = checkcaller or function() return false end
local newcclosure = newcclosure or function(f) return f end

if hookmetamethod and getrawmetatable then
    pcall(function()
        local grm = getrawmetatable(game)
        local setreadonly = setreadonly or make_writeable or function() end
        local oldNamecall

        setreadonly(grm, false)

        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            if not checkcaller() and Config.RemoteSpyActive then
                if method == "FireServer" or method == "InvokeServer" then
                    pcall(function()
                        local remotePath = self:GetFullName()
                        local formattedArgs = {}

                        for i = 1, #args do
                            local arg = args[i]
                            if type(arg) == "string" then
                                table.insert(formattedArgs, '"' .. tostring(arg) .. '"')
                            elseif typeof(arg) == "Instance" then
                                table.insert(formattedArgs, "game." .. arg:GetFullName())
                            elseif type(arg) == "table" then
                                table.insert(formattedArgs, "{...}")
                            else
                                table.insert(formattedArgs, tostring(arg))
                            end
                        end

                        local argString = table.concat(formattedArgs, ", ")
                        local modeTag = Config.BlockRemoteServer and "[MODE 1: BLOCK]" or "[MODE 2: NORMAL]"
                        
                        -- บันทึกเป็นรูปแบบคำสั่ง Lua ที่นำไปก๊อปปี้รันได้เลย
                        local logEntry = string.format("%s game.%s:%s(%s)\n", modeTag, remotePath, method, argString)
                        table.insert(Config.LoggedRemotes, logEntry)
                    end)

                    if Config.BlockRemoteServer then
                        return nil
                    end
                end
            end

            return oldNamecall(self, ...)
        end))

        setreadonly(grm, true)
    end)
end

