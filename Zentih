-- 3. GARBAGE COLLECTOR & RAM MEMORY (สแกนวัตถุใน RAM)
-- ==========================================================
local function scanGCMemory()
    local gcLines = {
        "\n========================================",
        "LAYER 3: GARBAGE COLLECTOR & RAM MEMORY",
        "========================================"
    }
    local count = 0

    if getgc then
        local gcList = getgc(true)
        for _, item in ipairs(gcList) do
            if type(item) == "table" and rawget(item, "FireServer") then
                count = count + 1
                table.insert(gcLines, string.format("[%04d] Found Custom Network Table in RAM Memory", count))
            elseif typeof(item) == "Instance" and (item:IsA("RemoteEvent") or item:IsA("RemoteFunction")) then
                if not item.Parent then
                    count = count + 1
                    table.insert(gcLines, string.format("[%04d] [UNPARENTED REMOTE] [%s] %s -> game.%s", count, item.ClassName, item.Name, item:GetFullName()))
                end
            end
        end
        table.insert(gcLines, 1, "-- Total GC Memory Items: " .. tostring(count))
    else
        table.insert(gcLines, "-- Executor ของคุณไม่รองรับ getgc()")
    end

    return gcLines
end

