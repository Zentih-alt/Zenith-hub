-- 🔍 ENGINE 3: HIDDEN & NIL INSTANCE SCANNER (เจาะวัตถุซ่อนใน Memory)
-- ==========================================================
local function scanNilInstances()
    local nilText = "-- === ZENTIH HUB: NIL & HIDDEN INSTANCES DUMP === --\n\n"
    local count = 0
    
    if getnilinstances then
        local nilList = getnilinstances()
        for i, obj in ipairs(nilList) do
            pcall(function()
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") or obj:IsA("ModuleScript") or obj:IsA("BindableEvent") then
                    count = count + 1
                    nilText = nilText .. string.format("[%04d] [%s] %s (Parent: %s)\n", count, obj.ClassName, obj.Name, obj.Parent and obj.Parent:GetFullName() or "Nil/Memory")
                end
            end)
        end
        nilText = nilText .. "\n-- Total Hidden Objects Found: " .. tostring(count) .. "\n"
    else
        nilText = nilText .. "-- Executor ของคุณไม่รองรับ getnilinstances()\n"
    end
    
    return nilText, count
end

local function scanGCRemotes()
    local gcText = "-- === ZENTIH HUB: GARBAGE COLLECTOR (GC) REMOTES === --\n\n"
    local count = 0

    if getgc then
        local gcList = getgc(true)
        for _, item in ipairs(gcList) do
            if type(item) == "table" and rawget(item, "FireServer") then
                count = count + 1
                gcText = gcText .. string.format("[%04d] Found Remote Table in GC\n", count)
            elseif typeof(item) == "Instance" and (item:IsA("RemoteEvent") or item:IsA("RemoteFunction")) then
                count = count + 1
                gcText = gcText .. string.format("[%04d] [%s] %s -> game.%s\n", count, item.ClassName, item.Name, item:GetFullName())
            end
        end
        gcText = gcText .. "\n-- Total GC Remotes Found: " .. tostring(count) .. "\n"
    else
        gcText = gcText .. "-- Executor ของคุณไม่รองรับ getgc()\n"
    end

    return gcText, count
end

