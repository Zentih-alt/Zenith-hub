-- 4. MAP & WORKSPACE INTERACTIVE OBJECTS (ดึง CFrame / Position / CollectionService)
-- ==========================================================
local function scanWorkspacePositions()
    local mapLines = {
        "\n========================================",
        "LAYER 4: WORKSPACE & INTERACTIVE POSITIONS",
        "========================================"
    }
    local count = 0

    -- 1. สแกนหาวัตถุโต้ตอบ เช่น แท่นวาร์ป หรือ Pods
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local lowerName = string.lower(obj.Name)
            if lowerName:find("tp") or lowerName:find("teleport") or lowerName:find("pad") or lowerName:find("zone") or lowerName:find("pod") or lowerName:find("door") then
                count = count + 1
                local pos = obj.Position
                table.insert(mapLines, string.format("[ZONE/PAD] Path: game.%s | Vector3.new(%.2f, %.2f, %.2f) | CFrame = CFrame.new(%.2f, %.2f, %.2f)",
                    obj:GetFullName(), pos.X, pos.Y, pos.Z, pos.X, pos.Y, pos.Z))
            end
        end
    end

    -- 2. สแกนดึง Tags จาก CollectionService
    pcall(function()
        table.insert(mapLines, "\n--- CollectionService Tagged Objects ---")
        local tags = {"Monster", "Enemy", "Tower", "SpawnPoint", "Spot", "UnitSpot"}
        for _, tag in ipairs(tags) do
            local taggedObjects = CollectionService:GetTagged(tag)
            if #taggedObjects > 0 then
                table.insert(mapLines, string.format("\nTag: '%s' (%d Objects Found):", tag, #taggedObjects))
                for i, tObj in ipairs(taggedObjects) do
                    if tObj:IsA("BasePart") then
                        local pos = tObj.Position
                        table.insert(mapLines, string.format("  [%d] game.%s | Vector3.new(%.2f, %.2f, %.2f)", i, tObj:GetFullName(), pos.X, pos.Y, pos.Z))
                    else
                        table.insert(mapLines, string.format("  [%d] game.%s (%s)", i, tObj:GetFullName(), tObj.ClassName))
                    end
                end
            end
        end
    end)

    table.insert(mapLines, 1, "-- Total Map Positions Found: " .. tostring(count))
    return mapLines
end

