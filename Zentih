                            elseif cat == "INTERACTION" and item:IsA("ProximityPrompt") then
                                extraInfo = string.format(" [Action: '%s', Object: '%s']", item.ActionText, item.ObjectText)
                            end
                            table.insert(buffer, string.format("%s (%s)%s\n", item:GetFullName(), item.ClassName, extraInfo))
                        end
                        if i % 1000 == 0 then task.wait() end
                    end
                    table.insert(buffer, "\n")
                end
            end
            table.insert(buffer, "Total Items Extracted: " .. count .. "\n")
            SaveFileToRootFolder(Config.MainFilename, buffer)
        end)
