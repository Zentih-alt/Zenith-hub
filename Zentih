local function CreateCleanToggleBtn()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ZenithCleanToggleGui"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true

    if gethui then
        ScreenGui.Parent = gethui()
    elseif syn and syn.protect_gui then
        syn.protect_gui(ScreenGui)
        ScreenGui.Parent = CoreGui
    else
        local parentOk = pcall(function() ScreenGui.Parent = CoreGui end)
        if not parentOk then
            ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
        end
    end

    -- ปุ่มวงกลมไร้ขอบ
    local Frame = Instance.new("Frame")
    Frame.Name = "CleanToggleButtonFrame"
    Frame.Size = UDim2.fromOffset(52, 52)
    Frame.Position = UDim2.new(0.02, 0, 0.25, 0)
    Frame.BackgroundTransparency = 1 -- ไร้ขอบและไร้พื้นหลังแข็ง
    Frame.BorderSizePixel = 0
    Frame.Active = true
    Frame.Parent = ScreenGui

    local ImageBtn = Instance.new("ImageButton")
    ImageBtn.Name = "LogoBtn"
    ImageBtn.Size = UDim2.fromScale(1, 1)
    ImageBtn.Position = UDim2.fromScale(0, 0)
    ImageBtn.BackgroundTransparency = 1
    ImageBtn.BorderSizePixel = 0
    ImageBtn.Image = LogoAsset
    ImageBtn.Parent = Frame

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(1, 0) -- ทำเป็นทรงกลมเป๊ะๆ
    BtnCorner.Parent = ImageBtn

    -- Dragging Logic for Touch & Mouse
    local dragging, dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end

    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)

    -- Toggle GUI Visibility Action
    ImageBtn.MouseButton1Click:Connect(function()
        pcall(function()
            if Window.Toggle then
                Window:Toggle()
            elseif Window.ToggleVisibility then
                Window:ToggleVisibility()
            elseif Window.SetVisible then
                Window:SetVisible(not Window.Visible)
            end
        end)
    end)
end

