--------------------------------------------------------------------------------
-- ⚡ Smart File Saver
--------------------------------------------------------------------------------
local function SaveFileToRootFolder(baseFilename, dataTable)
    if not string.match(baseFilename, "%.txt$") and not string.match(baseFilename, "%.lua$") then
        baseFilename = baseFilename .. ".txt"
    end

    local path = UI_TEXTS.SUBFOLDER_NAME .. "/" .. baseFilename

    if writefile then
        pcall(function()
            writefile(path, table.concat(dataTable))
        end)

        Rayfield:Notify({
            Title = "Zenith Soul HUB",
            Content = "บันทึกไฟล์ไปที่ " .. path .. " เรียบร้อย!",
            Duration = 3,
            Image = 4483362458
        })
    end
end

--------------------------------------------------------------------------------
-- 🎯 Filter Function (ดึงเฉพาะส่วนทำสคริปต์)
--------------------------------------------------------------------------------
local function IsEssentialData(item)
    local className = item.ClassName

    if className == "RemoteEvent" or className == "RemoteFunction" or className == "BindableEvent" or className == "BindableFunction" then
        return true, "REMOTE"
    elseif className == "LocalScript" or className == "ModuleScript" or className == "Script" then
        return true, "SCRIPT"
    elseif item:IsA("ValueBase") then
        return true, "VALUE"
    elseif className == "ProximityPrompt" or className == "ClickDetector" or className == "TouchInterest" or className == "TouchTransmitter" then
        return true, "INTERACTION"
    elseif item:IsA("Tool") or className == "Humanoid" then
        return true, "GAMEPLAY"
    elseif item:IsA("TextButton") or item:IsA("ImageButton") or item:IsA("TextBox") or item:IsA("ScreenGui") then
        return true, "UI"
    elseif className == "Folder" or className == "Model" or className == "Configuration" then
        return true, "CONTAINER"
    end

    return false, nil
end

