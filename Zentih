-- ==========================================================
-- 🛠️ ENGINE 1: Tree Dump System (ระบบรางไม้)
-- ==========================================================
local function generateTreeDump()
    local dumpText = "-- ========================================\n"
    dumpText = dumpText .. "-- ZENITH HUB: ROBLOX GAME DUMP DATA\n"
    dumpText = dumpText .. "-- Place ID: " .. tostring(game.PlaceId) .. "\n"
    dumpText = dumpText .. "-- Date: " .. os.date("%Y-%m-%d %H:%M:%S") .. "\n"
    dumpText = dumpText .. "-- Format: " .. Config.TreeStyle .. "\n"
    dumpText = dumpText .. "-- ========================================\n\n"

    local function dumpNode(object, depth, isLast, prefix)
        depth = depth or 0
        if depth > Config.MaxDepth then return "" end

        prefix = prefix or ""
        local text = ""
        local currentBranch = ""
        local nextPrefix = ""

        local className = object.ClassName
        local name = object.Name
        
        -- Filter logic
        if Config.FilterType == "เฉพาะ Remote" then
            if not (className == "RemoteEvent" or className == "UnreliableRemoteEvent" or className == "RemoteFunction") then
                local hasRemoteChild = false
                for _, child in ipairs(object:GetChildren()) do
                    if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                        hasRemoteChild = true
                        break
                    end
                end
                if not hasRemoteChild then return "" end
            end
        elseif Config.FilterType == "เฉพาะ ModuleScript" then
            if className ~= "ModuleScript" and #object:GetChildren() == 0 then
                return ""
            end
        end

        -- Branch styling
        if Config.TreeStyle == "Railway (├──)" then
            currentBranch = isLast and "└── " or "├── "
            nextPrefix = prefix .. (isLast and "    " or "│   ")
        elseif Config.TreeStyle == "Short Code" then
            currentBranch = string.rep("  ", depth)
            nextPrefix = ""
        else
            currentBranch = string.rep("- ", depth)
            nextPrefix = ""
        end

        local tag = "[" .. className .. "]"
        if className == "RemoteEvent" or className == "UnreliableRemoteEvent" then
            tag = "[RemoteEvent ⚡]"
        elseif className == "RemoteFunction" then
            tag = "[RemoteFunction 🔄]"
        elseif className == "ModuleScript" then
            tag = "[ModuleScript 📜]"
        end

        text = text .. prefix .. currentBranch .. tag .. " " .. name

        if className == "RemoteEvent" or className == "RemoteFunction" then
            text = text .. " -> Path: game." .. object:GetFullName()
        end

        if Config.DumpAttributes then
            local attributes = object:GetAttributes()
            local attrStrs = {}
            for k, v in pairs(attributes) do
                table.insert(attrStrs, tostring(k) .. "=" .. tostring(v))
            end
            if #attrStrs > 0 then
                text = text .. " {Attributes: " .. table.concat(attrStrs, ", ") .. "}"
            end
        end

        text = text .. "\n"

        local children = object:GetChildren()
        for i, child in ipairs(children) do
            local childIsLast = (i == #children)
            text = text .. dumpNode(child, depth + 1, childIsLast, nextPrefix)
        end

        return text
    end

    local services = getSelectedServices()
    for _, service in ipairs(services) do
        pcall(function()
            dumpText = dumpText .. "\n========================================\n"
            dumpText = dumpText .. "SERVICE: " .. service.Name .. "\n"
            dumpText = dumpText .. "========================================\n"
            local children = service:GetChildren()
            for i, child in ipairs(children) do
                dumpText = dumpText .. dumpNode(child, 0, i == #children, "")
            end
        end)
    end

    return dumpText
end

-- ==========================================================
-- ⚡ ENGINE 2: ULTIMATE REMOTE SPY (ระบบอัด Remote ขั้นสุด)
-- ==========================================================
local function serializeArg(val)
    local t = typeof(val)
    if t == "string" then
        return '"' .. tostring(val) .. '"'
    elseif t == "Instance" then
        return "game." .. val:GetFullName()
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.2f, %.2f, %.2f)", val.X, val.Y, val.Z)
    elseif t == "CFrame" then
        return string.format("CFrame.new(%.2f, %.2f, %.2f)", val.Position.X, val.Position.Y, val.Position.Z)
    elseif t == "Color3" then
        return string.format("Color3.fromRGB(%d, %d, %d)", math.floor(val.R * 255), math.floor(val.G * 255), math.floor(val.B * 255))
    elseif t == "table" then
        local pairsStr = {}
        for k, v in pairs(val) do
            local keyStr = typeof(k) == "string" and ('["' .. k .. '"]') or ("[" .. tostring(k) .. "]")
            table.insert(pairsStr, keyStr .. " = " .. serializeArg(v))
        end
        return "{" .. table.concat(pairsStr, ", ") .. "}"
    else
        return tostring(val)
    end
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if Config.RemoteSpyEnabled and (method == "FireServer" or method == "InvokeServer") then
        local remotePath = self:GetFullName()
        
        -- Ignored Noise Filters
        local isIgnored = false
        if Config.IgnoreMovement and (string.find(remotePath, "Move") or string.find(remotePath, "Position") or string.find(remotePath, "Physics") or string.find(remotePath, "Walk")) then
            isIgnored = true
        end
        if Config.IgnoreChat and (string.find(remotePath, "Chat") or string.find(remotePath, "SayMessage") or string.find(remotePath, "Bubble")) then
            isIgnored = true
        end
        if Config.IgnorePing and (string.find(remotePath, "Ping") or string.find(remotePath, "Latency") or string.find(remotePath, "Heartbeat")) then
            isIgnored = true
        end

        if not isIgnored then
            Config.TotalCalls = Config.TotalCalls + 1
            Config.RemoteCounts[remotePath] = (Config.RemoteCounts[remotePath] or 0) + 1

            local formattedArgs = {}
            for i, arg in ipairs(args) do
                formattedArgs[i] = serializeArg(arg)
            end

            local timestamp = os.date("%H:%M:%S")
            local logLine = string.format("[%s] [Call #%d] game.%s:%s(%s)", timestamp, Config.RemoteCounts[remotePath], remotePath, method, table.concat(formattedArgs, ", "))
            table.insert(Config.CapturedRemotes, logLine)

            if Config.LogToConsole then
                print("[Zenith RemoteSpy #" .. Config.TotalCalls .. "]: " .. logLine)
            end
        end
    end

    return oldNamecall(self, ...)
end)

