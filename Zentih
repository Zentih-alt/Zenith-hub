-- ทำความสะอาดชื่อไฟล์ให้ปลอดภัยสำหรับระบบไฟล์
local function sanitizeFileName(str)
    if type(str) ~= "string" then return "file" end
    return str:gsub('[%c%s%:%*%?%"%<%>%|%\\]', "_")
end

-- สแกนหากลุ่ม Services ที่ต้องการ DUMP
