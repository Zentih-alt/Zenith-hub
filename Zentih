local function serializeArg(val, visited)
    visited = visited or {}
    local t = typeof(val)
    if t == "string" then
        return '"' .. tostring(val) .. '"'
    elseif t == "Instance" then
        return "game." .. val:GetFullName()
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.2f, %.2f, %.2f)", val.X, val.Y, val.Z)
    elseif t == "CFrame" then
        return string.format("CFrame.new(%.2f, %.2f, %.2f)", val.Position.X, val.Position.Y, val.Position.Z)
    elseif t == "table" then
        if visited[val] then return "{...}" end
        visited[val] = true
        local pairsStr = {}
        for k, v in pairs(val) do
            local keyStr = typeof(k) == "string" and ('["' .. k .. '"]') or ("[" .. tostring(k) .. "]")
            table.insert(pairsStr, keyStr .. " = " .. serializeArg(v, visited))
        end
        return "{" .. table.concat(pairsStr, ", ") .. "}"
    else
        return tostring(val)
    end
end

-- Metamethod Hooking
local oldNamecall
if hookmetamethod and getrawmetatable then
    pcall(function()
        local grm = getrawmetatable(game)
        local setreadonly = setreadonly or make_writeable or function() end
        
        setreadonly(grm, false)

        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = {...}

            -- เมื่อปิด Remote Spy หรือสคริปต์ตัวเองเรียก จะส่งสัญญาณกลับมาเป็นปกติทันที 100%
            if not Config.RemoteSpyEnabled or checkcaller() then
                return oldNamecall(self, ...)
            end

            if method == "FireServer" or method == "InvokeServer" then
                local remotePath = self:GetFullName()
                
                local isIgnored = false
                if Config.IgnoreMovement and (remotePath:find("Move") or remotePath:find("Position") or remotePath:find("Physics") or remotePath:find("Walk")) then isIgnored = true end
                if Config.IgnoreChat and (remotePath:find("Chat") or remotePath:find("SayMessage") or remotePath:find("Bubble")) then isIgnored = true end
                if Config.IgnoreAnims and (remotePath:find("Animate") or remotePath:find("HandleAnimations") or remotePath:find("Ping")) then isIgnored = true end

                if not isIgnored then
                    Config.TotalCalls = Config.TotalCalls + 1
                    Config.CapturedRemotePaths[remotePath] = (Config.CapturedRemotePaths[remotePath] or 0) + 1

                    local formattedArgs = {}
                    for i, arg in ipairs(args) do
                        table.insert(formattedArgs, serializeArg(arg))
                    end

                    local timestamp = os.date("%H:%M:%S")
                    local logLine = ""

                    if Config.RawTraceMode then
                        local unpackArgs = table.concat(formattedArgs, ",\n\t")
                        logLine = string.format("-- [%s] Call #%d\nlocal args = {\n\t%s\n}\ngame:GetService(\"%s\"):WaitForChild(\"%s\"):FireServer(unpack(args))\n",
                            timestamp, Config.TotalCalls, unpackArgs, self.Parent and self.Parent.Name or "ReplicatedStorage", self.Name)
                    else
                        if Config.LastClickedUI and (tick() - Config.LastClickTime < 0.6) then
                            logLine = string.format("[%s] %s -> TRIGGERED: game.%s:%s(%s)", 
                                timestamp, Config.LastClickedUI, remotePath, method, table.concat(formattedArgs, ", "))
                            Config.LastClickedUI = nil
                        else
                            local callerScript = "Unknown Script"
                            if getcallingscript then
                                local s = getcallingscript()
                                if s then callerScript = s:GetFullName() end
                            end
                            logLine = string.format("[%s] [Call #%d] [Caller: game.%s] game.%s:%s(%s)", 
                                timestamp, Config.CapturedRemotePaths[remotePath], callerScript, remotePath, method, table.concat(formattedArgs, ", "))
                        end
                    end

                    table.insert(Config.CapturedRemotes, logLine)
                    if Config.LogToConsole then print("[Zentih RemoteSpy]: " .. logLine) end
                end

                -- แบบที่ 1 (Block Mode): บล็อกไม่ให้ส่งข้อมูลไปทางเซิร์ฟเวอร์
                if Config.BlockRemoteServer then
                    return nil
                end
            end

            -- แบบที่ 2 (Normal Mode): เล่นได้ตามปกติและส่งสัญญาณไปหาเกมปกติ 100%
            return oldNamecall(self, ...)
        end))

        setreadonly(grm, true)
    end)
end

